[Unit]
Description=nightly-sentry-agent (Sentry -> Claude Code -> PR)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Adjust the user and paths to your installation
User=sentry-agent
# Read by systemd as root before dropping to User=, so the file can stay root-only
# (chmod 600) and the agent user cannot open it.
EnvironmentFile=/etc/nightly-sentry-agent.env
# systemd starts with a minimal PATH; claude/uv live in ~/.local/bin, bun in ~/.bun/bin
Environment=PATH=/home/sentry-agent/.local/bin:/home/sentry-agent/.bun/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/home/sentry-agent/nightly-sentry-agent
ExecStart=/home/sentry-agent/nightly-sentry-agent/run.sh
# CLAUDE_TIMEOUT defaults to 3 h; leave room for installs, the gate and the push
TimeoutStartSec=4h
Nice=10
NoNewPrivileges=yes
PrivateTmp=yes
