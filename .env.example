# Copy to .env next to run.sh (chmod 600), or to a root-only file used as a
# systemd EnvironmentFile. Every value is read from the environment.

# ---------------------------------------------------------------- secrets
# Claude Code auth: `claude setup-token` (subscription) or an API key
CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# Sentry user auth token with READ-ONLY scopes: org:read, project:read, event:read
SENTRY_AUTH_TOKEN=

# GitHub fine-grained PAT limited to GH_REPOS:
# Contents: read/write, Pull requests: read/write. Nothing else.
GH_TOKEN=

# ---------------------------------------------------------------- required
SENTRY_ORG=my-org
# Space-separated owner/name list. Each is cloned into work/<name>.
GH_REPOS="my-org/web my-org/api"

# ---------------------------------------------------------------- optional
# EU-hosted Sentry organizations: https://de.sentry.io
# SENTRY_BASE_URL=https://sentry.io
# SENTRY_PROJECTS=web,api          # only these project slugs (default: all)
# SENTRY_QUERY=is:unresolved
# SENTRY_ISSUE_LIMIT=25

# Branch to start from and open PRs against
# BASE_BRANCH=main

# Extra commands the agent may run, ';'-separated prefixes (tests, linters, type checks)
# ALLOWED_BASH="npm test;npx tsc;uv run pytest"

# Dev server for browser checks with Playwright MCP (all three or none)
# DEV_SERVER_REPO=web
# DEV_SERVER_CMD="npm run dev -- -p 3100"
# DEV_SERVER_URL=http://localhost:3100
# PLAYWRIGHT_MCP_VERSION=0.0.86
# PLAYWRIGHT_BROWSER=chromium

# Model and budget
# MODEL=claude-opus-5-5
# EFFORT=high
# CLAUDE_TIMEOUT=3h

# Triage thresholds
# MIN_EVENTS_24H=5
# MIN_USERS=2
# MAX_FIX_LINES=50
# MAX_FIX_FILES=3
# RETRIAGE_DAYS=7

# A diff touching these path prefixes never becomes a PR
# PROTECTED_PATHS=".github/ .githooks/ .husky/ .gitattributes .gitmodules"

# Project-specific instructions appended to the prompt
# CONTEXT_FILE=./context.md

# Commit identity (standard git variables)
# GIT_AUTHOR_NAME="Nightly Sentry Agent"
# GIT_AUTHOR_EMAIL=nightly-agent@users.noreply.github.com
# GIT_COMMITTER_NAME="Nightly Sentry Agent"
# GIT_COMMITTER_EMAIL=nightly-agent@users.noreply.github.com

# Paths (default: next to run.sh)
# WORK_DIR=./work
# STATE_DIR=./state
# RUNS_DIR=./runs

# 1 = full run without push / PR. Start with this.
DRY_RUN=1
